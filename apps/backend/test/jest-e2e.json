{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", {
      "tsconfig": {
        "paths": {},
        "baseUrl": "."
      }
    }]
  },
  "testEnvironment": "node",
  "testTimeout": 60000,
  "forceExit": true,
  "verbose": true,
  "maxWorkers": 1,
  "globalSetup":    "<rootDir>/test/setup-e2e.ts",
  "globalTeardown": "<rootDir>/test/teardown-e2e.ts"
}
