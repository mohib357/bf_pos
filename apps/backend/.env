# ============================================================
# Barakah Finance POS — Local Development Environment
# DO NOT COMMIT THIS FILE
# ============================================================

NODE_ENV=development
PORT=3001
APP_NAME="Barakah Finance POS"
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

DATABASE_URL="postgresql://postgres:password@localhost:5432/bf_pos?schema=public"

JWT_SECRET=bf-pos-jwt-secret-dev-change-in-production-32chars!!
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=bf-pos-refresh-secret-dev-change-in-production-32chars!!
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_ROUNDS=12

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

LOG_LEVEL=debug
LOG_DIR=./logs

THROTTLE_TTL=60
THROTTLE_LIMIT=100

CORS_ORIGINS=http://localhost:3000,http://localhost:3001

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@barakahfinance.com
SEED_ADMIN_PASSWORD=Admin@123456
SEED_ADMIN_PHONE=01700000000
