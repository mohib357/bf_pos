# ============================================================
# Barakah Finance POS -- Backend Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# Application
NODE_ENV=development
PORT=3001
APP_NAME="Barakah Finance POS"
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/bf_pos?schema=public"

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt password hashing rounds
BCRYPT_ROUNDS=12

# Redis Cache (optional -- falls back to in-memory if unavailable)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Logging
LOG_LEVEL=debug
LOG_DIR=./logs

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# CORS (comma-separated origins)
# Dev:  http://localhost:3000,http://127.0.0.1:3000
# Prod: https://pos.barakahfinance.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Opening Capital (used by seed and scripts/seed-opening-capital.ts)
# Override per deployment to set initial cash/bank balances
OPENING_CAPITAL_CASH=50000
OPENING_CAPITAL_BANK=20000
OPENING_CAPITAL_BKASH=10000
OPENING_CAPITAL_NAGAD=5000
# Set to 'true' to force re-seed opening capital
RESET_OPENING_CAPITAL=false

# Default Super Admin (used by seed only)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@barakahfinance.com
SEED_ADMIN_PASSWORD=Admin@123456
SEED_ADMIN_PHONE=01700000000
